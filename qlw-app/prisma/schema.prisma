generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  service     String?
  message     String?
  notes       String?  @db.Text
  tags        String?
  status      String   @default("New") // New, In Discussion, Client
  isArchived  Boolean  @default(false)
  source      String   @default("Website Form")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
